  "components": {
    "schemas": {
      "AutoplayInput": {
        "properties": {
          "video_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Id"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 25
          }
        },
        "type": "object",
        "title": "AutoplayInput"
      },
      "CorrectionInput": {
        "properties": {
          "tidal_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Tidal Id"
          },
          "video_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Video Id"
          }
        },
        "type": "object",
        "required": [
          "tidal_id",
          "video_id"
        ],
        "title": "CorrectionInput"
      },
      "DecodeInput": {
        "properties": {
          "tidal_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Tidal Id"
          },
          "expect_hires": {
            "type": "boolean",
            "title": "Expect Hires",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "tidal_id"
        ],
        "title": "DecodeInput"
      },
      "EventInput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "occurrence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Occurrence Id"
          },
          "seconds": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Seconds"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "occurrence_id",
          "seconds"
        ],
        "title": "EventInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeaseInput": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "release": {
            "type": "boolean",
            "title": "Release",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "LeaseInput"
      },
      "OccurrenceInput": {
        "properties": {
          "tidal_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Tidal Id"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "video_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Id"
          }
        },
        "type": "object",
        "required": [
          "tidal_id"
        ],
        "title": "OccurrenceInput"
      },
      "PlaybackInput": {
        "properties": {
          "occurrence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Occurrence Id"
          },
          "seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Seconds"
          },
          "coverage_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Coverage Seconds"
          },
